/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com https://open.spotify.com; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
